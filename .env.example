# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real API keys.

# Required to email quote-form enquiries to angelo@mecdetailingaust.com.au.
# Get a free key at https://resend.com — no card required.
# Without this set, submissions still succeed for the customer but are
# only logged server-side, not delivered.
RESEND_API_KEY=

# Optional. Defaults to Resend's shared test address (onboarding@resend.dev)
# if unset, which works immediately with no domain setup. For a branded
# from-address (e.g. "MEC Detailing <enquiries@mecdetailingaust.com.au>"),
# verify mecdetailingaust.com.au in the Resend dashboard first.
QUOTE_FROM_EMAIL=
