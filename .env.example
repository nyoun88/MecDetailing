# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real API keys.

# Required to email quote-form enquiries to angelo@mecdetailingaust.com.au.
# Get a free key at https://resend.com — no card required.
# Without this set, submissions still succeed for the customer but are
# only logged server-side, not delivered.
RESEND_API_KEY=

# Optional. Defaults to Resend's shared test address (onboarding@resend.dev)
# if unset, which works immediately with no domain setup. For a branded
# from-address (e.g. "MEC Detailing <enquiries@mecdetailingaust.com.au>"),
# verify mecdetailingaust.com.au in the Resend dashboard first.
QUOTE_FROM_EMAIL=

# Optional. Powers the live Google review pulls in components/sections/
# reviews.tsx and the "5.0 on Google (N)" badge — without these two set,
# the site falls back to the static rating in data/business.ts with no
# written reviews shown (current default behaviour, nothing breaks).
#
# GOOGLE_PLACES_API_KEY — Google Cloud Console → APIs & Services →
# Credentials → Create Credentials → API key. Enable "Places API (New)"
# for the project first, then restrict the key to that API. Set it as an
# env var on your host (e.g. Vercel project settings) rather than
# committing it — this file is just the template.
GOOGLE_PLACES_API_KEY=

# GOOGLE_PLACE_ID — the Place ID for the MEC Detailing Aust. Kedron
# Business Profile. Find it with Google's Place ID finder:
# https://developers.google.com/maps/documentation/places/web-service/place-id
# (search the business name, copy the ID it shows — it looks like
# ChIJ...).
GOOGLE_PLACE_ID=
